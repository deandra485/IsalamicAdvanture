##############################################
# ISLAMICADVANTURE — ENV TEMPLATE
# Copy file ini ke .env, lalu isi nilainya
##############################################

# ── APP ──────────────────────────────────────
APP_NAME="IslamicAdvanture"
APP_ENV=production
APP_KEY=                        # jalankan: php artisan key:generate
APP_DEBUG=false
APP_URL=https://yourdomain.com  # ← ganti dengan domain asli

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── LOGGING ──────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error               # production: error (jangan debug)

# ── DATABASE (MySQL / Cloud SQL) ──────────────
DB_CONNECTION=mysql
DB_HOST=                      # ← IP Cloud SQL atau DB server
DB_PORT=3306
DB_DATABASE=islamicadvanturer
DB_USERNAME=                  # ← username DB production
DB_PASSWORD=                  # ← password DB production

# ── SESSION ───────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true          # production: aktifkan enkripsi session
SESSION_PATH=/
SESSION_DOMAIN=               # ← domain tanpa https, cth: yourdomain.com

# ── CACHE & QUEUE ─────────────────────────────
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ── FILESYSTEM ────────────────────────────────
# Pilih 'local' jika hosting biasa, 'gcs' jika pakai Google Cloud Storage
FILESYSTEM_DISK=public

# ── MAIL ──────────────────────────────────────
# Rekomendasi: pakai Mailgun atau Google SMTP
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com      # atau: smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=                # ← email pengirim (ex: no-reply@yourdomain.com)
MAIL_PASSWORD=                # ← app password Gmail atau API key Mailgun
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="IslamicAdvanture"

# ── GOOGLE OAUTH (Login dengan Google) ────────
# Buat di: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=             # ← Client ID dari Google Console
GOOGLE_CLIENT_SECRET=         # ← Client Secret dari Google Console
GOOGLE_REDIRECT_URL=https://yourdomain.com/auth/google/callback

# ── MIDTRANS PAYMENT ──────────────────────────
# Buat akun di: https://dashboard.midtrans.com
MIDTRANS_SERVER_KEY=          # ← Server Key dari Midtrans Dashboard
MIDTRANS_CLIENT_KEY=          # ← Client Key dari Midtrans Dashboard
MIDTRANS_IS_PRODUCTION=true   # false = sandbox mode, true = production

# ── RECAPTCHA (opsional) ─────────────────────
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── REDIS (opsional, untuk cache/queue lebih cepat) ──
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ── GOOGLE CLOUD STORAGE (opsional) ───────────
# Aktifkan jika ingin simpan file upload ke GCS
# GOOGLE_CLOUD_PROJECT_ID=
# GOOGLE_CLOUD_STORAGE_BUCKET=

VITE_APP_NAME="${APP_NAME}"
